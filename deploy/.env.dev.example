# 이 파일을 pi2의 /opt/rodi-app/.env 로 복사해 실제 값으로 채우세요 (chmod 600, 소유자 deploy).
# .env 는 git에 커밋하지 않습니다 (.gitignore 처리됨).

# --- DB (pi, PostgreSQL + PostGIS) ---
DB_HOST=192.168.0.11
DB_PORT=5432
DB_NAME=rodi_dev
DB_USERNAME=rodi
DB_PASSWORD=

# --- JWT — 운영과 다른 값 (openssl rand -base64 48) ---
JWT_SECRET=

# --- 애플 로그인 (운영과 같은 앱이면 같은 값) ---
#  APPLE_PRIVATE_KEY = .p8 내용을 한 줄로(-----BEGIN/END----- 및 개행 제거한 base64 본문)
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=
APPLE_PRIVATE_KEY=

# --- 카카오 Admin 키 (탈퇴 시 unlink). 카카오 콘솔 허용 IP에 집 공인 IP 등록 필요 ---
KAKAO_ADMIN_KEY=

# --- Discord 알림 (운영과 같은 웹훅, 메시지에 [dev] 라벨). 비우면 전송 안 함 ---
DISCORD_ERROR_WEBHOOK_URL=
DISCORD_HEALTH_WEBHOOK_URL=

# --- 이미지 태그·배포 메타데이터는 CD(deploy-dev.sh)가 주입. 수동 실행 시 생략하면 develop ---
# IMAGE_TAG=develop
